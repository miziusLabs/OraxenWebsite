---
interface Props {
	prefix: string;
	phrases: string[];
	color?: string;
	interval?: number;
	transitionDuration?: number;
	class?: string;
}

const {
	prefix,
	phrases,
	color = '#f5a800',
	interval = 1700,
	transitionDuration = 300,
	class: className,
} = Astro.props;

if (phrases.length === 0) {
	throw new Error('Highlighting requires at least one phrase.');
}

const initialPhrase = phrases[0] ?? '';
const holdDuration = Math.max(0, interval);
const animationDuration = Math.max(0, transitionDuration);
---

<span
	class:list={['highlighting', className]}
	data-highlighting
	data-phrases={JSON.stringify(phrases)}
	data-interval={holdDuration}
	data-transition-duration={animationDuration}
	style={`--highlight-color: ${color}; --highlight-transition-duration: ${animationDuration}ms;`}
>
	<span class="highlighting__prefix">{prefix}</span>
	<span class="highlighting__box">
		<span class="highlighting__text" aria-live="polite" aria-atomic="true">{initialPhrase}</span>
		<span class="highlighting__measure" aria-hidden="true">{initialPhrase}</span>
		<span class="highlighting__pixels" aria-hidden="true"></span>
	</span>
</span>

<script>
	const initializeHighlighting = () => {
		document.querySelectorAll<HTMLElement>('[data-highlighting]').forEach((highlighting) => {
			if (highlighting.dataset.initialized === 'true') {
				return;
			}

			highlighting.dataset.initialized = 'true';

			const text = highlighting.querySelector<HTMLElement>('.highlighting__text');
			const box = highlighting.querySelector<HTMLElement>('.highlighting__box');
			const measure = highlighting.querySelector<HTMLElement>('.highlighting__measure');
			const pixels = highlighting.querySelector<HTMLElement>('.highlighting__pixels');
			const rawPhrases = highlighting.dataset.phrases;

			if (!text || !box || !measure || !pixels || !rawPhrases) {
				return;
			}

			let parsedPhrases: unknown;
			try {
				parsedPhrases = JSON.parse(rawPhrases);
			} catch {
				return;
			}

			if (
				!Array.isArray(parsedPhrases) ||
				parsedPhrases.length === 0 ||
				parsedPhrases.some((phrase) => typeof phrase !== 'string')
			) {
				return;
			}

			const phrases = parsedPhrases as string[];
			const holdDuration = Math.max(0, Number(highlighting.dataset.interval) || 0);
			const transitionDuration = Math.max(
				0,
				Number(highlighting.dataset.transitionDuration) || 0,
			);
			let phraseIndex = 0;
			let scheduleId = 0;
			let swapId = 0;
			let finishId = 0;

			const measurePhrase = (phrase: string) => {
				measure.textContent = phrase;
				const styles = window.getComputedStyle(box);
				const horizontalPadding = Number.parseFloat(styles.paddingLeft) + Number.parseFloat(styles.paddingRight);
				const borderWidth = Number.parseFloat(styles.borderLeftWidth) + Number.parseFloat(styles.borderRightWidth);

				// Leave a small buffer for fractional glyph widths and font rasterization.
				return Math.ceil(measure.getBoundingClientRect().width + horizontalPadding + borderWidth + 2);
			};

			const setBoxWidth = (phrase: string, animate: boolean) => {
				const targetWidth = measurePhrase(phrase);

				if (!animate) {
					box.style.width = `${targetWidth}px`;
					return;
				}

				const currentWidth = box.getBoundingClientRect().width;
				box.style.width = `${currentWidth}px`;
				void box.offsetWidth;
				window.requestAnimationFrame(() => {
					box.style.width = `${targetWidth}px`;
				});
			};

			const createPixels = () => {
				pixels.replaceChildren();

				for (let index = 0; index < 38; index += 1) {
					const pixel = document.createElement('span');
					pixel.className = `highlighting__pixel${index % 4 === 0 ? ' highlighting__pixel--color' : ''}`;
					pixel.style.left = `${Math.random() * 105 - 2.5}%`;
					pixel.style.top = `${Math.random() * 105 - 2.5}%`;
					pixel.style.width = `${Math.round(4 + Math.random() * 7)}px`;
					pixel.style.height = `${Math.round(4 + Math.random() * 7)}px`;
					pixel.style.setProperty('--pixel-delay', `${Math.random() * transitionDuration * 0.12}ms`);
					pixel.style.setProperty('--pixel-drift-x', `${Math.round(Math.random() * 12 - 6)}px`);
					pixel.style.setProperty('--pixel-drift-y', `${Math.round(Math.random() * 10 - 5)}px`);
					pixels.append(pixel);
				}
			};

			const clearTimers = () => {
				window.clearTimeout(scheduleId);
				window.clearTimeout(swapId);
				window.clearTimeout(finishId);
			};

			const scheduleNextPhrase = () => {
				scheduleId = window.setTimeout(() => {
					const nextIndex = (phraseIndex + 1) % phrases.length;
					const nextPhrase = phrases[nextIndex] ?? phrases[0] ?? '';
					const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

					if (reducedMotion || transitionDuration === 0) {
						text.textContent = nextPhrase;
						phraseIndex = nextIndex;
						setBoxWidth(nextPhrase, false);
						scheduleNextPhrase();
						return;
					}

					createPixels();
					highlighting.classList.add('highlighting--transitioning');
					setBoxWidth(nextPhrase, true);

					swapId = window.setTimeout(() => {
						text.textContent = nextPhrase;
					}, transitionDuration * 0.45);

					finishId = window.setTimeout(() => {
						text.textContent = nextPhrase;
						phraseIndex = nextIndex;
						highlighting.classList.remove('highlighting--transitioning');
						pixels.replaceChildren();
						scheduleNextPhrase();
					}, transitionDuration);
				}, holdDuration);
			};

			setBoxWidth(phrases[0] ?? '', false);
			if (phrases.length > 1) {
				scheduleNextPhrase();
			}

			window.addEventListener(
				'resize',
				() => {
					if (!highlighting.classList.contains('highlighting--transitioning')) {
						setBoxWidth(phrases[phraseIndex] ?? '', false);
					}
				},
				{ passive: true },
			);

			document.fonts?.ready.then(() => {
				if (!highlighting.classList.contains('highlighting--transitioning')) {
					setBoxWidth(phrases[phraseIndex] ?? '', false);
				}
			});

			window.addEventListener('pagehide', clearTimers, { once: true });
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeHighlighting, { once: true });
	} else {
		initializeHighlighting();
	}
</script>

<style>
	.highlighting {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55ch;
		max-width: 100%;
		color: #f1fff4;
		font-family: 'Press Start 2P', 'Courier New', monospace;
		font-size: inherit;
		font-weight: 400;
		line-height: inherit;
		vertical-align: baseline;
	}

	.highlighting__prefix {
		flex: 0 0 auto;
		white-space: nowrap;
	}

	.highlighting__box {
		position: relative;
		display: inline-flex;
		flex: 0 1 auto;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: max-content;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
		padding: 0.45em 0.7em 0.38em;
		border: 2px solid color-mix(in srgb, var(--highlight-color), #000 14%);
		border-radius: 0.12em;
		background: var(--highlight-color);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.28),
			0 3px 0 rgba(0, 0, 0, 0.28),
			0 0.45em 1em rgba(0, 0, 0, 0.18);
		color: #000;
		isolation: isolate;
		transition: width var(--highlight-transition-duration) cubic-bezier(0.22, 0.8, 0.28, 1);
		will-change: width;
	}

	.highlighting__text {
		display: block;
		flex: 0 0 auto;
		white-space: nowrap;
		z-index: 1;
	}

	.highlighting__measure {
		position: absolute;
		top: 0;
		left: 0;
		visibility: hidden;
		width: max-content;
		max-width: none;
		white-space: nowrap;
		pointer-events: none;
	}

	.highlighting__pixels {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 2;
	}

	:global(.highlighting__pixel) {
		position: absolute;
		display: block;
		background: #000;
		opacity: 0;
		animation: highlighting-pixel var(--highlight-transition-duration) steps(3, end) var(--pixel-delay) both;
	}

	:global(.highlighting__pixel--color) {
		background: var(--highlight-color);
	}

	.highlighting--transitioning .highlighting__text {
		animation: highlighting-text var(--highlight-transition-duration) ease both;
	}

	@keyframes highlighting-pixel {
		0% {
			opacity: 0;
			transform: translate3d(0, 0, 0) scale(0.45);
		}

		18% {
			opacity: 0.95;
			transform: translate3d(0, 0, 0) scale(1);
		}

		68% {
			opacity: 0.85;
		}

		100% {
			opacity: 0;
			transform: translate3d(var(--pixel-drift-x), var(--pixel-drift-y), 0) scale(0.8);
		}
	}

	@keyframes highlighting-text {
		0%,
		24% {
			opacity: 1;
			transform: translateY(0);
		}

		42%,
		58% {
			opacity: 0;
			transform: translateY(-0.1em);
		}

		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.highlighting__box {
			transition: none;
		}

		.highlighting--transitioning .highlighting__text,
		:global(.highlighting__pixel) {
			animation: none;
		}
	}
</style>
