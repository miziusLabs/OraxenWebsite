---
import Button from '../components/Button.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#002727" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Oraxen</title>
	</head>
	<body>
		<canvas id="background-canvas" aria-hidden="true"></canvas>
		<main class="hero-content">
			<h1 class="hero-title">Oraxen</h1>
			<p class="hero-subtitle">
				Oraxen is a Minecraft plugin that allows server owners, administrators, and developers to easily create
				custom content through configuration files and a simple resource pack setup.
			</p>
			<section class="hero-cards" aria-label="Compatibility">
				<article class="info-card">Folia / Paper</article>
				<article class="info-card">1.20.1-26.2</article>
			</section>
			<div class="hero-actions">
				<Button href="https://discord.gg/pkpJFt43C7" variant="discord">Discord</Button>
				<Button href="https://docs.oraxen.com/" variant="docs">Docs</Button>
				<Button href="https://docs.oraxen.com/introduction#purchasing" variant="purchase">Purchase</Button>
			</div>
		</main>

		<script>
			const canvas = document.querySelector<HTMLCanvasElement>('#background-canvas');
			const context = canvas?.getContext('2d', { alpha: false });

			if (!canvas || !context) {
				throw new Error('The animated background could not be initialized.');
			}

			const BASE_COLOR = '#002727';
			const CYCLE_DURATION = 27.5;
			const GRID_SPACING = 14;
			const DOT_SIZE = 8;
			const DOT_COLORS = [
				'rgba(0, 24, 27, 0.22)',
				'rgba(0, 22, 25, 0.34)',
				'rgba(0, 20, 23, 0.48)',
				'rgba(0, 18, 21, 0.64)',
				'rgba(0, 15, 18, 0.82)',
			];

			type Dot = { x: number; y: number };

			let dots: Dot[] = [];
			let width = 0;
			let height = 0;
			// Start in the active part of the loop so the background is visible immediately.
			let elapsed = 8.5;
			let lastFrame = performance.now();
			let animationFrame = 0;
			let reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const clamp = (value: number, minimum = 0, maximum = 1) =>
				Math.min(maximum, Math.max(minimum, value));

			const smoothstep = (edge0: number, edge1: number, value: number) => {
				const normalized = clamp((value - edge0) / (edge1 - edge0));
				return normalized * normalized * (3 - 2 * normalized);
			};

			const createDots = () => {
				dots = [];
				const xOffset = ((width % GRID_SPACING) + GRID_SPACING) / 2 - GRID_SPACING;
				const yOffset = ((height % GRID_SPACING) + GRID_SPACING) / 2 - GRID_SPACING;

				for (let y = yOffset; y < height + DOT_SIZE; y += GRID_SPACING) {
					for (let x = xOffset; x < width + DOT_SIZE; x += GRID_SPACING) {
						dots.push({ x, y });
					}
				}
			};

			const resize = () => {
				width = window.innerWidth;
				height = window.innerHeight;
				const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

				canvas.width = Math.floor(width * pixelRatio);
				canvas.height = Math.floor(height * pixelRatio);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;
				context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
				createDots();
				draw(elapsed);
			};

			const fieldAt = (x: number, y: number, time: number) => {
				// Work in a square-ish coordinate system so the pattern keeps its scale
				// when the viewport switches between portrait and landscape.
				const aspect = width / height;
				const normalizedX = (x / width - 0.5) * aspect;
				const normalizedY = y / height - 0.5;
				const cycle = (time / CYCLE_DURATION) * Math.PI * 2;

				// A gently warped set of waves produces the soft, irregular edge of the
				// moving mask without needing an image, texture, or third-party library.
				const warpedX =
					normalizedX +
					0.2 * Math.sin(normalizedY * 4.1 - cycle * 1.1) +
					0.08 * Math.sin(normalizedY * 9.2 + cycle * 0.65);
				const warpedY =
					normalizedY +
					0.16 * Math.sin(normalizedX * 3.1 + cycle * 0.85) +
					0.08 * Math.cos(normalizedX * 8 - cycle * 0.45);

				const broadWave =
					0.5 +
					0.5 *
						(0.58 * Math.sin(warpedX * 2.45 - warpedY * 1.55 + cycle * 0.8) +
							0.25 * Math.sin(warpedX * 4.9 + warpedY * 2.1 - cycle * 0.55) +
							0.17 * Math.cos(warpedX * 1.35 + warpedY * 5.2 + cycle * 0.35));

				const verticalFlow =
					0.5 +
					0.5 *
						Math.sin(
							warpedY * 3.3 + Math.sin(warpedX * 2.4 - cycle * 0.4) * 1.2 - cycle * 0.35,
						);

				const rightHandBias = smoothstep(-0.2, 0.58, normalizedX);
				const movingPocketX = 0.05 + 0.34 * Math.sin(cycle - 1.15);
				const movingPocketY = 0.08 + 0.32 * Math.cos(cycle * 0.9 - 0.65);
				const pocketDistance =
					((normalizedX - movingPocketX) / 0.52) ** 2 +
					((normalizedY - movingPocketY) / 0.7) ** 2;
				const movingPocket = Math.exp(-pocketDistance * 1.35);

				const noise = broadWave * 0.64 + verticalFlow * 0.18 + rightHandBias * 0.1 + movingPocket * 0.22;
				return clamp((noise - 0.46) / 0.44);
			};

			const draw = (time: number) => {
				context.fillStyle = BASE_COLOR;
				context.fillRect(0, 0, width, height);

				const cycleTime = time % CYCLE_DURATION;
				const fadeIn = smoothstep(1.8, 5.2, cycleTime);
				const fadeOut = 1 - smoothstep(22.8, CYCLE_DURATION, cycleTime);
				const cycleOpacity = Math.min(fadeIn, fadeOut);

				if (cycleOpacity <= 0) {
					return;
				}

				const cycle = (time / CYCLE_DURATION) * Math.PI * 2;
				const glowX = width * (0.64 + Math.sin(cycle * 0.8 - 0.7) * 0.16);
				const glowY = height * (0.43 + Math.cos(cycle * 0.7 + 0.8) * 0.2);
				const glow = context.createRadialGradient(
					glowX,
					glowY,
					0,
					glowX,
					glowY,
					Math.max(width, height) * 0.75,
				);
				glow.addColorStop(0, `rgba(8, 63, 55, ${0.13 * cycleOpacity})`);
				glow.addColorStop(0.5, `rgba(3, 48, 43, ${0.065 * cycleOpacity})`);
				glow.addColorStop(1, 'rgba(0, 39, 39, 0)');
				context.fillStyle = glow;
				context.fillRect(0, 0, width, height);

				const layers = DOT_COLORS.map(() => new Path2D());
				for (const dot of dots) {
					const influence = fieldAt(dot.x, dot.y, time) * cycleOpacity;
					if (influence < 0.035) {
						continue;
					}

					const layer = Math.min(layers.length - 1, Math.floor(influence * layers.length));
					layers[layer].rect(dot.x, dot.y, DOT_SIZE, DOT_SIZE);
				}

				for (let index = 0; index < layers.length; index += 1) {
					context.fillStyle = DOT_COLORS[index];
					context.fill(layers[index]);
				}
			};

			const startAnimation = () => {
				if (animationFrame || reducedMotion || document.hidden) {
					return;
				}

				lastFrame = performance.now();
				animationFrame = window.requestAnimationFrame(render);
			};

			const stopAnimation = () => {
				if (animationFrame) {
					window.cancelAnimationFrame(animationFrame);
					animationFrame = 0;
				}
			};

			const render = (timestamp: number) => {
				animationFrame = 0;
				if (document.hidden || reducedMotion) {
					return;
				}

				elapsed += Math.min(timestamp - lastFrame, 80) / 1000;
				lastFrame = timestamp;
				draw(elapsed);
				startAnimation();
			};

			const handleVisibilityChange = () => {
				if (document.hidden) {
					stopAnimation();
					return;
				}

				lastFrame = performance.now();
				draw(elapsed);
				startAnimation();
			};

			const handleMotionPreference = (event: MediaQueryListEvent) => {
				reducedMotion = event.matches;
				stopAnimation();
				if (reducedMotion) {
					draw(8.5);
				} else {
					lastFrame = performance.now();
					startAnimation();
				}
			};

			window.addEventListener('resize', resize, { passive: true });
			document.addEventListener('visibilitychange', handleVisibilityChange);
			window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', handleMotionPreference);

			resize();
			if (reducedMotion) {
				draw(8.5);
			} else {
				startAnimation();
			}

			const buttonSound = new Audio('/button.mp3');
			buttonSound.preload = 'auto';
			buttonSound.load();

			const playButtonSound = () => {
				buttonSound.currentTime = 0;
				void buttonSound.play().catch(() => undefined);
			};

			document.querySelectorAll<HTMLAnchorElement>('.minecraft-button').forEach((button) => {
				button.addEventListener('pointerdown', (event) => {
					if (event.isPrimary && event.button === 0) {
						playButtonSound();
					}
				});
				button.addEventListener('click', (event) => {
					if (event.detail === 0) {
						playButtonSound();
					}
				});
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html),
	:global(body) {
		width: 100%;
		min-height: 100%;
		margin: 0;
		background: #002727;
	}

	:global(body) {
		min-height: 100svh;
		overflow: hidden;
		isolation: isolate;
	}

	#background-canvas {
		position: fixed;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.hero-content {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(1.2rem, 2.4vw, 2rem);
		padding: clamp(1.25rem, 4vw, 3rem);
		text-align: center;
	}

	.hero-title {
		margin: 0;
		color: #f1fff4;
		font-family: 'Press Start 2P', 'Courier New', monospace;
		font-size: clamp(2.25rem, 9vw, 7.5rem);
		font-weight: 400;
		letter-spacing: 0.06em;
		line-height: 1;
		text-shadow:
			0 0.07em 0 #0a4a43,
			0 0.14em 0 #063a36,
			0 0.22em 0.35em rgba(0, 0, 0, 0.38);
	}

	.hero-subtitle {
		width: min(100%, 58rem);
		margin: 0;
		color: rgba(241, 255, 244, 0.72);
		font-family: 'Press Start 2P', 'Courier New', monospace;
		font-size: clamp(0.5rem, 0.9vw, 0.7rem);
		line-height: 2;
		text-wrap: balance;
	}

	.hero-cards {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		width: min(100%, 36rem);
	}

	.info-card {
		position: relative;
		min-width: 0;
		padding: 0.55rem 0.8rem;
		border: 2px solid rgba(143, 231, 194, 0.42);
		border-radius: 0.15rem;
		background: linear-gradient(180deg, rgba(23, 107, 84, 0.48), rgba(0, 29, 31, 0.9));
		box-shadow:
			inset 0 1px 0 rgba(241, 255, 244, 0.16),
			0 3px 0 #063a36,
			0 0.5rem 1rem rgba(0, 0, 0, 0.24);
		color: #f1fff4;
		font-family: 'Press Start 2P', 'Courier New', monospace;
		font-size: clamp(0.48rem, 0.75vw, 0.62rem);
		line-height: 1.4;
		text-align: center;
		text-shadow: 0 0.1em 0 #063a36;
	}

	.info-card::before {
		position: absolute;
		inset: 0.2rem;
		border: 1px solid rgba(241, 255, 244, 0.12);
		content: '';
		pointer-events: none;
	}

	.info-card::after {
		position: absolute;
		top: -2px;
		left: -2px;
		width: 0.45rem;
		height: 0.2rem;
		background: #8fe7c2;
		box-shadow: 0.65rem 0 #176b54;
		content: '';
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	@media (max-width: 36rem) {
		.hero-content {
			gap: 1.1rem;
			padding: 1.25rem;
		}

		.hero-title {
			font-size: clamp(2rem, 12vw, 3.25rem);
			letter-spacing: 0.04em;
		}

		.hero-subtitle {
			font-size: 0.5rem;
			line-height: 1.8;
		}

		.hero-cards {
			gap: 0.5rem;
			width: min(100%, 18rem);
		}

		.info-card {
			padding: 0.5rem 0.65rem;
			font-size: 0.48rem;
		}
	}
</style>
